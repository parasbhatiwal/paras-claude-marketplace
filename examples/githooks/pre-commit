#!/bin/sh
# Team pre-commit gate: format + lint + typecheck + secret scan.
#
# Language-agnostic: every check resolves through the standard task interface
# (see _lib.sh). A task the project does not define is reported and skipped —
# a task that is defined and fails blocks the commit.
#
# The TDD test-presence gate lives in the commit-msg hook, which is the only
# one that can see the commit message (the break-glass trailer).

set -e

# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

fail() { echo "✗ pre-commit blocked: $1" >&2; exit 1; }

for task in format-check lint typecheck; do
  set +e
  run_task "$task"
  status=$?
  set -e
  case $status in
    0)   ;;
    127) echo "· $task: not configured for this project (skipped)" ;;
    *)   fail "$task failed" ;;
  esac
done

# ------------------------------------------------------------- secret scan
# gitleaks only auto-loads `.gitleaks.toml`; a plain `gitleaks.toml` is
# silently ignored and the defaults are used instead. Pass --config explicitly
# so either filename works and the repo's real policy is the one applied.
if have gitleaks; then
  gl_config=""
  for c in .gitleaks.toml gitleaks.toml; do
    [ -f "$c" ] && gl_config="--config $c" && break
  done
  echo "→ gitleaks protect --staged ${gl_config}"
  # shellcheck disable=SC2086
  gitleaks protect --staged --no-banner $gl_config || fail "possible secret in staged diff"
else
  if git diff --cached | grep -nE '(-----BEGIN (RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,}|-----BEGIN CERTIFICATE-----)' >&2; then
    fail "possible secret in staged diff (install gitleaks for better scanning)"
  fi
fi

echo "✓ pre-commit gates passed"
