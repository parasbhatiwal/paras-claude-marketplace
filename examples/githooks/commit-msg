#!/bin/sh
# Team policy: every commit message must carry BOTH co-author trailers.
#   Co-Authored-By: <human>            (any non-Claude co-author line)
#   Co-Authored-By: Claude <...>
# Merge commits and fixup/squash autosquash commits are exempt.

msg_file="$1"

first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! grep -qi '^Co-Authored-By:.*Claude' "$msg_file"; then
  echo "✗ commit rejected: missing 'Co-Authored-By: Claude <noreply@anthropic.com>' trailer." >&2
  echo "  Team policy: all work is done with Claude. Use the commit-changes skill." >&2
  exit 1
fi

if ! grep -i '^Co-Authored-By:' "$msg_file" | grep -qvi 'Claude'; then
  echo "✗ commit rejected: missing human 'Co-Authored-By: <name> <email>' trailer." >&2
  echo "  Add yourself: Co-Authored-By: $(git config user.name) <$(git config user.email)>" >&2
  exit 1
fi

exit 0
