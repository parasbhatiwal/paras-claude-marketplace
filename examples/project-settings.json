{
  "extraKnownMarketplaces": {
    "parasbhatiwal": {
      "source": {
        "source": "github",
        "repo": "parasbhatiwal/paras-claude-marketplace",
        "ref": "stable"
      }
    }
  },
  "enabledPlugins": {
    "team-skills@parasbhatiwal": true
  },
  "permissions": {
    "comment": "Keep the allow list to the tasks THIS project actually uses; delete the rest. The task interface (make/just) keeps this short in any language.",
    "allow": [
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/*.keystore)"
    ]
  }
}
