# Standard task interface for the team's hooks and CI.
#
# Copy to your project root as `Makefile` and keep ONLY the block for your
# stack. Every target must exit non-zero on failure. Targets you genuinely
# do not need may be `@true` — but never make `test` a no-op.
#
# The hooks and CI call: install, format-check, lint, typecheck, test,
# test-coverage, build, security. Anything not defined here falls back to
# ecosystem detection (see .githooks/_lib.sh); defining them makes a polyglot
# or unusual project uniform.

.PHONY: install format format-check lint typecheck test test-coverage build security ci

ci: format-check lint typecheck test-coverage security

# ---------------------------------------------------------------- JS / TS ---
install:        ; npm ci
format:         ; npx prettier --write .
format-check:   ; npx prettier --check .
lint:           ; npx eslint .
typecheck:      ; npx tsc --noEmit
test:           ; npx vitest run
test-coverage:  ; npx vitest run --coverage
build:          ; npm run build
security:       ; npm audit --audit-level=high

