{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/team-skills-hook.sh\" codex-session-context.mjs", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/team-skills-hook.sh\" codex-guard-git.mjs", "timeout": 30 }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/team-skills-hook.sh\" codex-guard-quality.mjs", "timeout": 30 }
        ]
      }
    ]
  }
}
